    <path
        android:fillColor="#FFFFB3C6"
        android:pathData="M142,68 A3.5,3.5 0 1,1 141.9,68 Z M58,128 A3,3 0 1,1 57.9,128 Z M132,136 A3,3 0 1,1 131.9,136 Z M68,66 A2.5,2.5 0 1,1 67.9,66 Z" />
