        android:pathData="M100,56 A44,44 0 1,1 99.9,56 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#B3FF7597" />
    <!-- Core glowing nucleus -->
    <path
        android:pathData="M100,76 A24,24 0 1,1 99.9,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="24"
                android:type="radial">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FFFF7597" android:offset="0.4" />
