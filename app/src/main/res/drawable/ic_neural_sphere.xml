                <item android:color="#66FF4772" android:offset="0.0" />
                <item android:color="#33B81D43" android:offset="0.45" />
                <item android:color="#146E0D25" android:offset="0.75" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Outer wireframe sphere -->
    <path
        android:fillColor="#00000000"
        android:pathData="M100,28 A72,72 0 1,1 99.9,28 Z"
        android:strokeWidth="1.2"
        android:strokeColor="#66FF6B8E" />
    <!-- Tilted orbital ring 1 -->
    <path
