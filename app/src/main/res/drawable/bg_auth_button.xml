<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FF809D">
    <item>
        <layer-list>
            <!-- Outer crimson glow base -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:centerColor="#A3193B"
                        android:endColor="#5E0B20"
                        android:startColor="#E0315B" />
                    <corners android:radius="999dp" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#B3FF6B8E" />
                </shape>
            </item>
            <!-- Top specular glass highlight -->
            <item
                android:bottom="26dp"
                android:left="14dp"
                android:right="14dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#45FFD6E0" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
