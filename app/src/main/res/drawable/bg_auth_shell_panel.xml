<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080507" />
        </shape>
    </item>
    <item
        android:bottom="320dp"
        android:left="-80dp"
        android:right="-80dp"
        android:top="-120dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#268A1533"
                android:endColor="#00080507"
                android:gradientRadius="320dp"
                android:startColor="#4D9E193B"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
