<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Outer soft crimson aura -->
    <path
        android:pathData="M60,8 A52,52 0 1,1 59.9,8 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="60"
                android:centerY="60"
                android:gradientRadius="52"
                android:type="radial">
                <item android:color="#66E63963" android:offset="0.0" />
                <item android:color="#338F1432" android:offset="0.7" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main 3D glass sphere body -->
    <path
        android:pathData="M60,18 A42,42 0 1,1 59.9,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="46"
                android:centerY="42"
                android:gradientRadius="48"
                android:type="radial">
                <item android:color="#FF597D" android:offset="0.0" />
                <item android:color="#A8183B" android:offset="0.45" />
                <item android:color="#470717" android:offset="0.82" />
                <item android:color="#24030B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner dark ruby swirl -->
    <path
        android:fillColor="#4D1A0208"
        android:pathData="M34,64 C42,82 72,86 88,62 C94,52 92,36 80,28 C84,48 64,70 34,64 Z" />

    <!-- Rim highlight -->
    <path
        android:fillColor="#00000000"
        android:pathData="M60,19 A41,41 0 1,1 59.9,19 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#99FF8DA6" />

    <!-- Top-left glossy specular highlight -->
    <path
        android:fillColor="#99FFD9E2"
        android:pathData="M32,40 C36,28 48,22 60,23 C48,27 39,35 34,47 C32,45 31,42 32,40 Z" />

    <!-- Bottom-right glass reflection arc -->
    <path
        android:fillColor="#66FF7597"
        android:pathData="M48,93 C68,95 86,82 91,62 C88,78 72,90 52,90 C49,91 47,92 48,93 Z" />
</vector>

