<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_shell_panel"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="12dp">

    <!-- Top Brand Bar: AIStudy + Profile Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI"
            android:textColor="@color/auth_foreground"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="Study"
            android:textColor="#E0C8CF"
            android:textSize="22sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_history_profile"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_history_chip"
            android:gravity="center"
            android:text="👤"
            android:textColor="@color/auth_foreground"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Large Serif "History" Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="serif"
        android:text="History"
        android:textColor="@color/auth_foreground"
        android:textSize="40sp"
        android:textStyle="bold" />

    <!-- Search Pill -->
    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_history_chip"
        android:hint="🔍   Search history..."
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:textColor="@color/auth_foreground"
        android:textColorHint="@color/auth_muted_foreground"
        android:textSize="14sp" />

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_history_chip_active"
                android:paddingHorizontal="20dp"
                android:paddingVertical="9dp"
                android:text="@string/history_chip_all"
                android:textColor="@color/auth_primary_foreground"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_math"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_history_chip"
                android:paddingHorizontal="18dp"
                android:paddingVertical="9dp"
                android:text="@string/subject_math"
                android:textColor="@color/auth_foreground"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_science"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_history_chip"
                android:paddingHorizontal="18dp"
                android:paddingVertical="9dp"
                android:text="@string/subject_science"
                android:textColor="@color/auth_foreground"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_history_chip"
                android:paddingHorizontal="18dp"
                android:paddingVertical="9dp"
                android:text="@string/subject_history"
                android:textColor="@color/auth_foreground"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_history_chip"
                android:paddingHorizontal="18dp"
                android:paddingVertical="9dp"
                android:text="@string/subject_code"
                android:textColor="@color/auth_foreground"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_history_chip"
                android:paddingHorizontal="18dp"
                android:paddingVertical="9dp"
                android:text="@string/subject_language"
                android:textColor="@color/auth_foreground"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_starred"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_history_chip"
                android:paddingHorizontal="18dp"
                android:paddingVertical="9dp"
                android:text="@string/history_chip_starred"
                android:textColor="@color/auth_foreground"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_practice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/quiz_practice"
        android:visibility="gone"
        app:backgroundTint="@color/auth_brand"
        app:cornerRadius="14dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/history_empty"
            android:textColor="@color/auth_muted_foreground"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
