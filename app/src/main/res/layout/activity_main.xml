<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background"
    tools:context=".MainActivity">

    <!-- Left vertical navigation rail -->
    <LinearLayout
        android:id="@+id/side_nav"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_side_nav_pill"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/nav_home"
            style="@style/App.SideNav.Item">

            <ImageView
                android:id="@+id/nav_home_icon"
                style="@style/App.SideNav.Icon"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:id="@+id/nav_home_label"
                style="@style/App.SideNav.Label"
                android:text="Home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_ask"
            style="@style/App.SideNav.Item">

            <ImageView
                android:id="@+id/nav_ask_icon"
                style="@style/App.SideNav.Icon"
                android:src="@drawable/ic_nav_ask" />

            <TextView
                android:id="@+id/nav_ask_label"
                style="@style/App.SideNav.Label"
                android:text="Ask" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_history"
            style="@style/App.SideNav.Item">

            <ImageView
                android:id="@+id/nav_history_icon"
                style="@style/App.SideNav.Icon"
                android:src="@drawable/ic_nav_history" />

            <TextView
                android:id="@+id/nav_history_label"
                style="@style/App.SideNav.Label"
                android:text="History" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_progress"
            style="@style/App.SideNav.Item">

            <ImageView
                android:id="@+id/nav_progress_icon"
                style="@style/App.SideNav.Icon"
                android:src="@drawable/ic_nav_progress" />

            <TextView
                android:id="@+id/nav_progress_label"
                style="@style/App.SideNav.Label"
                android:text="Progress" />
        </LinearLayout>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/side_nav"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
